{
  "name": "@reachinbox/worker",
  "version": "1.0.0",
  "private": true,
  "description": "BullMQ distributed worker process for email job processing",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@reachinbox/shared": "workspace:*",
    "bullmq": "^5.8.7",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
