# ==============================================================================
# Environment Configuration Template
# ReachInbox-style Full-stack Email Job Scheduler
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application & API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Supabase / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler?schema=public"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# BullMQ Worker Configuration
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Ethereal SMTP (https://ethereal.email/create)
ETHEREAL_HOST="smtp.ethereal.email"
ETHEREAL_PORT=587
ETHEREAL_USER=""
ETHEREAL_PASSWORD=""
FROM_EMAIL="scheduler@reachinbox-demo.local"
FROM_NAME="ReachInbox Scheduler"

# Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Slack OAuth 2.0 & API
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/integrations/slack/callback"
SLACK_TOKEN_ENCRYPTION_KEY=""
SLACK_NOTIFICATION_CHANNEL_ID=""

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="email-jobs"
ELASTICSEARCH_API_KEY=""
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""

# Security & Sessions
JWT_SECRET="replace-with-a-secure-random-secret-for-jwt-token-signing"
SESSION_SECRET="replace-with-a-secure-random-secret-for-express-sessions"

# Bull Board admin access (comma-separated Google account emails; empty denies all)
BULL_BOARD_ADMIN_EMAILS=""

# Frontend Web App (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"
