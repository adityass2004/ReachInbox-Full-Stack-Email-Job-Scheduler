# ==============================================================================
# Environment Configuration Template (.env.example)
# ReachInbox Full-Stack Distributed Email Job Scheduler
#
# INSTRUCTIONS:
# - For local development without Docker: copy to .env.local
# - For production (Vercel & Cloud Run): configure these variables in their dashboards
# - NEVER commit real credentials or .env / .env.local files to version control
# ==============================================================================

# Application & API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Prisma)
# Local: postgresql://postgres:postgrespassword@localhost:5433/reachinbox
# Docker Internal: postgresql://postgres:postgrespassword@postgres:5432/reachinbox
# Cloud (Supabase / RDS): postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/reachinbox
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5433/reachinbox

# Redis & BullMQ
# Local: redis://localhost:6379
# Docker Internal: redis://redis:6379
# Managed (Upstash / Cloud Memorystore): rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# BullMQ Worker Configuration
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Ethereal SMTP (Test email delivery service)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
FROM_EMAIL=scheduler@reachinbox-demo.local
FROM_NAME="ReachInbox Scheduler"

# Google OAuth 2.0
# Local callback: http://localhost:4000/api/auth/google/callback
# Production callback: https://<cloud-run-api-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth 2.0 & Alerts (Optional)
# Local redirect: http://localhost:4000/api/integrations/slack/callback
# Production redirect: https://<cloud-run-api-domain>/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
SLACK_TOKEN_ENCRYPTION_KEY=
SLACK_NOTIFICATION_CHANNEL_ID=

# Elasticsearch (Optional: full-text search fallback to PostgreSQL)
# Local: http://localhost:9200
# Docker Internal: http://elasticsearch:9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=email-jobs
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Security & Sessions (Provide cryptographically secure >=32 char strings)
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-for-jwt-tokens
SESSION_SECRET=replace-with-a-secure-random-32-byte-secret-for-sessions
BULL_BOARD_ADMIN_EMAILS=

# Frontend Web Application (Next.js)
# Local: http://localhost:4000
# Production: https://<cloud-run-api-domain>
NEXT_PUBLIC_API_URL=http://localhost:4000
